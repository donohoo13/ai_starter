#!/usr/bin/env python3
"""sdd: state and mechanical checks for spec-driven development.

Keeps the working files under docs/sdd/<slug>/ honest: creates them from the
templates, hashes and approves them, lints their structure, derives the
current phase, keeps the journal of what is in flight, and keeps the templates
in sync with the document.
Git decides where that folder is: the current checkout's own while any checkout
tracks a file under docs/sdd/, and otherwise the main checkout's, ignored
through the repository's local exclude file and shared by every worktree.
Behavior follows sections 4 and 5 of .claude/sdd/spec-driven-development.md,
which lives beside this script; SDD_HOME overrides that location for tests.
"""
from __future__ import annotations

import argparse
import datetime
import functools
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import NamedTuple

ARTIFACTS = ("spec", "design", "plan", "tasks", "review")
UPSTREAM = {"design": "spec", "plan": "spec", "tasks": "plan", "review": "tasks"}
DOC_NAME = "spec-driven-development.md"
SKILL_NAMES = ("sdd-outline", "sdd-design", "sdd-plan", "sdd-task", "sdd-implement", "tdd", "sdd-review")


class Refusal(Exception):
    """A command declined to act; the message goes to stderr and the exit code is 1."""


# --- locations ---------------------------------------------------------------


def sdd_home() -> Path:
    return Path(os.environ.get("SDD_HOME") or Path(__file__).resolve().parents[1])


def skills_dir() -> Path:
    return sdd_home().parent / "skills"


def git(*args: str, cwd: Path | None = None, timeout: float | None = None) -> str | None:
    """Run a git command and return its stdout without surrounding whitespace, or None when it fails, would prompt, or outlasts the timeout."""
    output = git_output(*args, cwd=cwd, timeout=timeout)
    return None if output is None else output.strip()


def git_output(*args: str, cwd: Path | None = None, timeout: float | None = None) -> str | None:
    """Run a git command and return its stdout exactly as printed, or None when it fails, would prompt, or outlasts the timeout."""
    try:
        result = subprocess.run(
            ["git", *args],
            cwd=cwd,
            capture_output=True,
            text=True,
            check=False,
            timeout=timeout,
            env={**os.environ, "GIT_TERMINAL_PROMPT": "0"},
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    return result.stdout


def project_root() -> Path:
    top = git("rev-parse", "--show-toplevel")
    return Path(top) if top else Path.cwd()


STORE_DIR = "docs/sdd"
SHARED = "shared"
PRIVATE = "private"
EXCLUDE_PATTERN = "/%s/" % STORE_DIR
EXCLUDE_NOTE = "# sdd: git tracks nothing under %s/ here, so this repository's specs stay out of git" % STORE_DIR


class Store(NamedTuple):
    """The folder that holds every spec's working folder, and how git treats it (section 5)."""

    mode: str  # SHARED: tracked, staged and committed; PRIVATE: ignored, never staged
    path: Path
    checkout: Path | None  # the checkout that holds `path`, or None outside git


def worktree_paths(checkout: Path) -> list[Path]:
    """The path git lists for every worktree of the repository, the main one first."""
    listing = git("worktree", "list", "--porcelain", cwd=checkout) or ""
    prefix = "worktree "
    return [Path(line[len(prefix) :]) for line in listing.splitlines() if line.startswith(prefix)]


def tracks_spec_files(checkout: Path) -> bool:
    return checkout.is_dir() and bool(git("ls-files", "--", STORE_DIR, cwd=checkout))


def is_main_checkout(checkout: Path) -> bool:
    """Whether this checkout owns the git directory, rather than being a linked worktree of it."""
    git_dir = git("rev-parse", "--absolute-git-dir", cwd=checkout)
    common_dir = git("rev-parse", "--git-common-dir", cwd=checkout)
    return bool(git_dir and common_dir) and Path(git_dir).resolve() == (checkout / common_dir).resolve()


def is_checkout(path: Path) -> bool:
    """Whether the path is the top of a work tree; git also lists a bare repository, or a git directory kept apart from its checkout, as the main worktree."""
    top = git("rev-parse", "--show-toplevel", cwd=path) if path.is_dir() else None
    return bool(top) and Path(top).resolve() == path.resolve()


def main_checkout(current: Path, listed: list[Path]) -> Path | None:
    """The checkout that outlives every linked worktree, or None when git lists none."""
    if is_main_checkout(current) or not listed:
        return current
    return listed[0] if is_checkout(listed[0]) else None


def resolve_store() -> Store:
    """Ask git where the specs live: shared when any checkout of the repository tracks a file under docs/sdd/, private otherwise.

    Every worktree shares one local exclude file, so the mode is the repository's, never one branch's.
    """
    top = git("rev-parse", "--show-toplevel")
    if not top:
        return Store(PRIVATE, Path.cwd() / STORE_DIR, None)
    current = Path(top)
    listed = worktree_paths(current)
    others = [path for path in listed if path.resolve() != current.resolve()]
    if any(tracks_spec_files(checkout) for checkout in [current, *others]):
        return Store(SHARED, current / STORE_DIR, current)
    main = main_checkout(current, listed)
    if main is None:
        raise Refusal(
            "git tracks nothing under %s/, so this repository's specs are private and live in its main checkout, "
            "but git lists none: the main worktree is bare, or its git directory sits apart from its checkout; "
            "run this from the main checkout or a clone that has one, or track the specs by committing %s/.gitkeep"
            % (STORE_DIR, STORE_DIR)
        )
    return Store(PRIVATE, main / STORE_DIR, main)


def is_ignored(checkout: Path) -> bool:
    """Whether some ignore rule already hides the spec folder of this checkout."""
    return git("check-ignore", "-q", STORE_DIR + "/", cwd=checkout) is not None


def exclude_file(checkout: Path) -> Path:
    """The repository's local exclude file, which every worktree shares and no commit carries."""
    return checkout / (git("rev-parse", "--git-path", "info/exclude", cwd=checkout) or ".git/info/exclude")


def note(message: str) -> None:
    """Say what the helper did or found on its own, on stderr so `--json` output stays parseable."""
    print("sdd: %s" % message, file=sys.stderr)


def sync_exclude(store: Store) -> None:
    """Keep the local exclude file in step with the mode: a private folder is ignored once it exists, and a shared one is not hidden by the entry a private run left."""
    if store.checkout is None:
        return
    exclude = exclude_file(store.checkout)
    lines = exclude.read_text().splitlines(keepends=True) if exclude.is_file() else []
    others = [line for line in lines if line.strip() not in (EXCLUDE_PATTERN, EXCLUDE_NOTE)]
    has_entry = others != lines
    if store.mode == SHARED:
        if has_entry:
            exclude.write_text("".join(others))
            note(
                "shared repository: removed %s from %s, since git now tracks files under %s/"
                % (EXCLUDE_PATTERN, exclude, STORE_DIR)
            )
        return
    if has_entry or not store.path.is_dir() or is_ignored(store.checkout):
        return
    separator = "" if not lines or lines[-1].endswith("\n") else "\n"
    exclude.parent.mkdir(parents=True, exist_ok=True)
    exclude.write_text("".join(lines) + separator + EXCLUDE_NOTE + "\n" + EXCLUDE_PATTERN + "\n")
    note(
        "private repository: added %s to %s, so git ignores the spec folder in every worktree"
        % (EXCLUDE_PATTERN, exclude)
    )


def report_stray_folders(store: Store) -> None:
    """A private repository reads only its main checkout's folder, so a spec folder inside another worktree is unread, and is deleted with that worktree."""
    if store.mode != PRIVATE or store.checkout is None:
        return
    current = project_root()
    if current.resolve() == store.checkout.resolve():
        return
    strays = sorted(path.parent.name for path in (current / STORE_DIR).glob("*/spec.md"))
    if strays:
        note(
            "warning: %s holds spec folders this private repository does not read (%s); move them to %s"
            % (current / STORE_DIR, ", ".join(strays), store.path)
        )


@functools.lru_cache(maxsize=None)
def spec_store() -> Store:
    """The store for this run, resolved once; `main` forgets it, since a later run may start in another repository."""
    store = resolve_store()
    sync_exclude(store)
    report_stray_folders(store)
    return store


def describe_mode(store: Store) -> str:
    """The mode and what it means for staging, as `init`, `status` and `root` print it."""
    if store.mode == SHARED:
        return "shared (git tracks %s/: stage spec files by explicit path)" % STORE_DIR
    if store.checkout is None:
        return "private (not a git repository: nothing to stage or commit)"
    return "private (git ignores %s/ and every worktree reads this one folder: never stage or commit a spec file)" % STORE_DIR


def sdd_dir() -> Path:
    return spec_store().path


def current_branch() -> str:
    return git("symbolic-ref", "--short", "HEAD") or ""


REMOTE_HEAD = re.compile(r"^ref: refs/heads/(\S+)\s+HEAD$", re.MULTILINE)
REMOTE_TIMEOUT_SECONDS = 20


def default_branch() -> tuple[str, str]:
    """The remote's default branch and where it was read from, or two empty strings when git cannot tell.

    The origin/HEAD recorded in this clone answers first; the remote is asked only when that is missing.
    """
    recorded = git("symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD")
    if recorded:
        return recorded.split("/", 1)[-1], "origin/HEAD"
    listing = git("ls-remote", "--symref", "origin", "HEAD", timeout=REMOTE_TIMEOUT_SECONDS)
    reported = REMOTE_HEAD.search(listing or "")
    if reported:
        return reported.group(1), "the remote"
    return "", ""


def today() -> str:
    return datetime.date.today().isoformat()


def now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# --- frontmatter -------------------------------------------------------------


def parse_frontmatter(text: str) -> tuple[dict[str, str], str]:
    """Split a markdown file into its `key: value` frontmatter and its body."""
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---\n", 4)
    if end == -1:
        return {}, text
    fields: dict[str, str] = {}
    for line in text[4:end].splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        fields[key.strip()] = value.strip().strip('"').strip("'")
    return fields, text[end + 5 :]


def set_frontmatter(text: str, updates: dict[str, str]) -> str:
    """Return the text with each frontmatter key set, appending keys that are absent."""
    if not text.startswith("---\n"):
        raise Refusal("file has no frontmatter")
    end = text.find("\n---\n", 4)
    if end == -1:
        raise Refusal("file has no frontmatter")
    lines = text[4:end].splitlines()
    pending = dict(updates)
    for index, line in enumerate(lines):
        key = line.split(":", 1)[0].strip()
        if key in pending:
            lines[index] = frontmatter_entry(key, pending.pop(key))
    for key, value in pending.items():
        lines.append(frontmatter_entry(key, value))
    return "---\n" + "\n".join(lines) + text[end:]


def frontmatter_entry(key: str, value: str) -> str:
    """`key: value`, or a bare `key:` for an empty value, as the templates write it."""
    return "%s: %s" % (key, value) if value else "%s:" % key


# --- hashing -----------------------------------------------------------------

FOLLOW_UPS = re.compile(r"^## Follow-ups", re.IGNORECASE)
EVIDENCE = re.compile(r"^\s*- Evidence:", re.IGNORECASE)
TICKED_BOX = re.compile(r"^(\s*- )\[[xX]\]")

# Opens every block marker: a character no artifact holds, so a marker never reads as the file's own text.
BLOCK = "\x00"
BULLET, NUMBERED, RULE, CODE_FENCE, LINE_END = (BLOCK + mark for mark in ("-", "1", "---", "```", "$"))
RULE_LINE = re.compile(r"([-*_])(?:[ \t]*\1){2,}$")
ITEM_MARKER = re.compile(r"(?:[-*+]|(\d{1,9})[.)])(?:[ \t]+|$)")
TASK_BOX = re.compile(r"^\[[ xX]\](?=\s|$)")
HEADING_MARKER = re.compile(r"#{1,6}(?:[ \t]|$)")
FENCE_LINE = re.compile(r"(`{3,}|~{3,})[ \t]*(.*)$")
MARKDOWN_FENCE = re.compile(r"(?:markdown|md)\b", re.IGNORECASE)
TABLE_DIVIDER = re.compile(r"\|?[ \t]*:?-+:?[ \t]*(?:\|[ \t]*:?-+:?[ \t]*)*\|?$")
INLINE_MARKUP = re.compile(
    r"\\(?P<escaped>[!-/:-@\[-`{-~])|(?P<hard_break>\\$)|(?<!`)(?P<ticks>`+)(?!`)(?P<code>.+?)(?<!`)(?P=ticks)(?!`)",
    re.DOTALL | re.MULTILINE,
)
SPACE_BESIDE_PUNCTUATION = re.compile(r"(?<!\w) | (?!\w)")


def lines_outside_follow_ups(text: str) -> list[str]:
    """The lines below the frontmatter, without the Follow-ups section."""
    _, body = parse_frontmatter(text)
    kept: list[str] = []
    skipping = False
    for line in body.splitlines():
        if line.startswith("## "):
            skipping = bool(FOLLOW_UPS.match(line))
        if not skipping:
            kept.append(line)
    return kept


def lines_outside_progress_notes(text: str) -> list[str]:
    """The lines an approval covers: no Follow-ups section and no evidence note, nor the lines a formatter wrapped a note onto."""
    kept: list[str] = []
    note_indent = None
    for line in lines_outside_follow_ups(text):
        indent = len(line) - len(line.lstrip())
        if line.strip() and note_indent is not None and indent > note_indent:
            continue
        if EVIDENCE.match(line):
            note_indent = indent
            continue
        if line.strip():
            note_indent = None
        kept.append(line)
    return kept


class Fence(NamedTuple):
    """An open fenced block: the run of backticks or tildes that opened it, whether it holds code, and whether it sits in a block quote."""

    marker: str
    holds_code: bool
    quoted: bool

    def is_closed_by(self, line: str) -> bool:
        return re.fullmatch("%s{%d,}" % (re.escape(self.marker[0]), len(self.marker)), line) is not None


class BodyReader:
    """Reads a body line by line into what an approval covers: its words, numbers and punctuation in order, and the kind of block each sits in.

    Everything a formatter may rewrite is left out: how lines wrap, indent and space out, how far table cells are padded,
    which character marks a bullet, a rule, a fence or emphasis, the number an ordered item carries, and which characters prose escapes.
    Code keeps every character but its whitespace.
    """

    def __init__(self) -> None:
        self.pieces: list[str] = []
        self.paragraph: list[str] = []
        self.fences: list[Fence] = []
        self.item_column: int | None = None
        self.after_blank = False

    def read(self, raw: str) -> None:
        line = raw.strip()
        if self.fences and self.fences[-1].holds_code:
            self.read_code(line)
            return
        quoted = line.startswith(">")
        line = unquoted(line)
        if line:
            self.read_block(line, len(raw) - len(raw.lstrip()), quoted)
        else:
            self.close_paragraph()
            self.after_blank = True

    def wording(self) -> str:
        self.close_paragraph()
        spaced = " ".join(" ".join(self.pieces).split())
        return SPACE_BESIDE_PUNCTUATION.sub("", spaced) + "\n"

    def read_code(self, line: str) -> None:
        fence = self.fences[-1]
        if fence.quoted:
            line = unquoted(line)
        if fence.is_closed_by(line):
            self.fences.pop()
            self.pieces.append(CODE_FENCE)
        else:
            self.pieces.append(line)

    def read_block(self, line: str, indent: int, quoted: bool) -> None:
        left_the_item = self.item_column is not None and indent < self.item_column and not ITEM_MARKER.match(line)
        if self.after_blank and left_the_item:
            self.item_column = None
        self.after_blank = False
        line = self.read_markers(line, indent)
        if line:
            self.read_leaf(line, quoted)

    def read_markers(self, line: str, indent: int) -> str:
        """Record the rule or the list markers a line opens with, and return what follows them."""
        while line:
            if RULE_LINE.match(line):
                self.close_paragraph()
                self.item_column = None
                self.pieces.append(RULE)
                return ""
            item = ITEM_MARKER.match(line)
            if not item or not self.opens_an_item(item.group(1), indent):
                break
            self.close_paragraph()
            self.pieces.append(NUMBERED if item.group(1) else BULLET)
            indent += item.end()
            self.item_column = indent
            line = TASK_BOX.sub("[ ]", line[item.end() :])
        return line

    def opens_an_item(self, number: str | None, indent: int) -> bool:
        """Whether a list marker opens an item, or is text of the paragraph above it.

        Markdown lets a numbered line interrupt a paragraph only when it is numbered 1 or sits outside the list item
        that paragraph belongs to; any other is paragraph text, which a formatter folds into the line above or escapes.
        """
        if number is None or int(number) == 1 or not self.paragraph:
            return True
        return self.item_column is not None and indent < self.item_column

    def read_leaf(self, line: str, quoted: bool) -> None:
        """Record a fence, a heading, a table row or a line of a paragraph.

        A heading ends with its line, so the end is recorded too. A table row's is not: a formatter that wraps prose can start a paragraph's line with a pipe.
        """
        fence = FENCE_LINE.match(line)
        if fence and self.fences and not fence.group(2) and self.fences[-1].is_closed_by(line):
            self.close_paragraph()
            self.fences.pop()
            self.pieces.append(CODE_FENCE)
        elif fence and "`" not in fence.group(2):
            self.close_paragraph()
            language = fence.group(2).strip()
            self.fences.append(Fence(fence.group(1), not MARKDOWN_FENCE.match(language), quoted))
            self.pieces.append(CODE_FENCE + language)
        elif HEADING_MARKER.match(line):
            self.close_paragraph()
            self.item_column = None
            self.pieces.append(prose(line) + LINE_END)
        elif line.startswith("|"):
            self.close_paragraph()
            row = re.sub(r"-+", "-", line) if TABLE_DIVIDER.match(line) else line
            self.pieces.append(prose(row, in_table=True))
        else:
            self.paragraph.append(line)

    def close_paragraph(self) -> None:
        if self.paragraph:
            self.pieces.append(prose("\n".join(self.paragraph)))
            self.paragraph = []


def unquoted(line: str) -> str:
    """The line without the block quote markers it opens with."""
    while line.startswith(">"):
        line = line[1:].strip()
    return line


def prose(text: str, in_table: bool = False) -> str:
    """Inline text without the style a formatter may change: backslash escapes, hard breaks and the emphasis character.

    A code span stays as written, and so does an escaped pipe in a table row, where it is the only way to write a pipe that does not end the cell.
    """
    parts: list[str] = []
    last = 0
    for markup in INLINE_MARKUP.finditer(text):
        parts.append(starred(text[last : markup.start()]))
        if markup["code"] is not None:
            parts.append("`%s`" % markup["code"])
        elif markup["escaped"] == "|" and in_table:
            parts.append(markup.group())
        elif markup["escaped"]:
            parts.append(starred(markup["escaped"]))
        last = markup.end()
    parts.append(starred(text[last:]))
    return "".join(parts)


def starred(text: str) -> str:
    """Prettier writes emphasis with underscores where other formatters write stars, so an underscore reads as a star."""
    return text.replace("_", "*")


def wording(text: str) -> str:
    """The body as an approval covers it: what it says, without the progress notes and without anything a formatter may rewrite."""
    reader = BodyReader()
    for line in lines_outside_progress_notes(text):
        reader.read(line)
    return reader.wording()


def body_as_written(text: str) -> str:
    """The body as approvals covered it before the hash ignored formatting: each line as written, less progress marks and trailing whitespace."""
    kept = [TICKED_BOX.sub(r"\1[ ]", line).rstrip() for line in lines_outside_follow_ups(text) if not EVIDENCE.match(line)]
    while kept and not kept[-1]:
        kept.pop()
    return "\n".join(kept) + "\n"


def digest(covered: str) -> str:
    return hashlib.sha256(covered.encode("utf-8")).hexdigest()[:12]


def content_hash(text: str) -> str:
    return digest(wording(text))


def upstream_record(name: str, text: str, based_on: str) -> str:
    """What an approval covers beside the body: based_on for an artifact with an upstream, and a design's recorded version."""
    record = "based_on: %s\n" % based_on if name in UPSTREAM else ""
    if name == "design":
        record += "version: %s\n" % parse_frontmatter(text)[0].get("version", "")
    return record


def approval_hash(name: str, text: str, based_on: str) -> str:
    """The hash an approval records: the body's wording and its upstream record, so a re-approval against a new upstream or a re-read canvas stales what follows."""
    return digest(wording(text) + upstream_record(name, text, based_on))


def is_current_approval(name: str, approved_hash: str, text: str, based_on: str) -> bool:
    """An approval recorded under an earlier form of the hash still counts.

    Those forms covered the body as written, so one holds until a formatter rewrites the file:
    the body alone, the body with its upstream record, or a design's body and based_on without its version.
    """
    as_written = body_as_written(text)
    earlier = {digest(as_written), digest(as_written + upstream_record(name, text, based_on))}
    if name == "design":
        earlier.add(digest(as_written + "based_on: %s\n" % based_on))
    return approved_hash == approval_hash(name, text, based_on) or approved_hash in earlier


# --- command registry --------------------------------------------------------

COMMANDS: list[tuple[str, str, list, object]] = []


def command(name: str, help_text: str, *arguments):
    """Register a subcommand; each argument is (flags, kwargs) for argparse."""

    def wrap(fn):
        COMMANDS.append((name, help_text, list(arguments), fn))
        return fn

    return wrap


@command("hash", "Print the content hash of an artifact", (["file"], {}))
def cmd_hash(args: argparse.Namespace) -> int:
    path = Path(args.file)
    if not path.is_file():
        raise Refusal("no such file: %s" % path)
    print(content_hash(path.read_text()))
    return 0


# --- working folder ----------------------------------------------------------


def artifact_path(slug: str, name: str) -> Path:
    return sdd_dir() / slug / (name + ".md")


def read_artifact(slug: str, name: str) -> tuple[dict[str, str], str, str] | None:
    """Return (frontmatter, body, raw text) or None when the artifact is missing."""
    path = artifact_path(slug, name)
    if not path.is_file():
        return None
    text = path.read_text()
    fields, body = parse_frontmatter(text)
    return fields, body, text


def write_artifact(slug: str, name: str, text: str) -> None:
    artifact_path(slug, name).write_text(text)


def upstream_of(slug: str, name: str) -> str:
    """The artifact `name` builds on: the plan builds on the design while it is approved, else on the spec."""
    if name == "plan":
        design = read_artifact(slug, "design")
        if design and design[0].get("status") == "approved":
            return "design"
    return UPSTREAM[name]


def template(name: str) -> str:
    path = sdd_home() / "templates" / (name + ".md")
    if not path.is_file():
        raise Refusal("missing template %s; run `sdd templates sync`" % path)
    return path.read_text()


def all_slugs() -> list[str]:
    base = sdd_dir()
    if not base.is_dir():
        return []
    return sorted(p.parent.name for p in base.glob("*/spec.md"))


def resolve_slug(slug: str | None) -> str:
    """The slug argument, else the spec whose branch matches the current branch."""
    if slug:
        return slug
    return find_slug()


def find_slug() -> str:
    slugs = all_slugs()
    if not slugs:
        raise Refusal("no specs under %s" % sdd_dir())
    branch = current_branch()
    for slug in slugs:
        fields, _, _ = read_artifact(slug, "spec")
        if fields.get("branch") == branch:
            return slug
    raise Refusal(
        "no spec matches branch %r; existing slugs: %s" % (branch, ", ".join(slugs))
    )


@command("root", "Print the project root, the folder that holds every spec, and whether git tracks it")
def cmd_root(args: argparse.Namespace) -> int:
    store = spec_store()
    print("root: %s" % project_root())
    print("store: %s" % store.path)
    print("mode: %s" % describe_mode(store))
    return 0


def title_from_slug(slug: str) -> str:
    words = slug.replace("_", "-").split("-")
    return " ".join(words).strip().capitalize()


def ask_for_base(slug: str | None) -> str:
    """What to do when git cannot tell the base, the one case where the user is asked."""
    ask = (
        "git could not tell the remote's default branch (origin/HEAD is not recorded and the remote did not answer); "
        "ask the user which branch this work merges into"
    )
    return "%s, then run `sdd set-base %s <branch>`" % (ask, slug) if slug else ask


def record_detected_base(slug: str) -> str:
    return "run `sdd set-base %s` to record the remote's default branch" % slug


@command(
    "init",
    "Create spec.md from the template in a new docs/sdd/<slug>/, ignored by git when the repository is private",
    (["slug"], {}),
    (["--branch"], {"help": "feature branch to record; defaults to the current branch"}),
    (
        ["--base"],
        {"help": "branch the work is cut from and merges back into; defaults to the remote's default branch"},
    ),
)
def cmd_init(args: argparse.Namespace) -> int:
    path = artifact_path(args.slug, "spec")
    if path.exists():
        raise Refusal("%s already exists; run the skill on it to revise or resume" % path)
    text = template("spec")
    title = title_from_slug(args.slug)
    base, base_source = (args.base, "--base") if args.base else default_branch()
    text = set_frontmatter(
        text,
        {
            "title": title,
            "slug": args.slug,
            "branch": args.branch or current_branch(),
            "base": base,
            "owner": git("config", "user.name") or "",
            "created": today(),
            "updated": today(),
        },
    )
    text = re.sub(r"^# .*$", "# " + title, text, count=1, flags=re.MULTILINE)
    store = spec_store()
    path.parent.mkdir(parents=True, exist_ok=True)
    sync_exclude(store)
    path.write_text(text)
    print("created %s" % path)
    print("mode: %s" % describe_mode(store))
    if base:
        print("base: %s, from %s; `sdd set-base %s <branch>` changes it" % (base, base_source, args.slug))
    else:
        print("base: not recorded; %s" % ask_for_base(args.slug))
    return 0


@command("find", "Print the slug whose spec branch matches the current branch")
def cmd_find(args: argparse.Namespace) -> int:
    print(find_slug())
    return 0


def recorded_base(slug: str) -> str:
    """The base the spec records, or "" for a spec written before the field existed."""
    found = read_artifact(slug, "spec")
    if not found:
        raise Refusal("spec.md is missing for %s" % slug)
    return found[0].get("base", "")


def matching_slug() -> str | None:
    try:
        return find_slug()
    except Refusal:
        return None


@command(
    "base",
    "Print the base branch: the one the spec records, else the remote's default branch",
    (["slug"], {"nargs": "?"}),
)
def cmd_base(args: argparse.Namespace) -> int:
    slug = args.slug or matching_slug()
    recorded = recorded_base(slug) if slug else ""
    if recorded:
        print("base: %s" % recorded)
        print("source: spec %s" % slug)
        return 0
    base, source = default_branch()
    if not base:
        raise Refusal(ask_for_base(slug))
    print("base: %s" % base)
    if slug:
        print("source: detected from %s; spec.md records none, %s" % (source, record_detected_base(slug)))
    else:
        print("source: detected from %s; no spec matches the current branch" % source)
    return 0


@command(
    "set-base",
    "Record a spec's base: the named branch, or the remote's default branch when none is named",
    (["slug"], {}),
    (["branch"], {"nargs": "?"}),
)
def cmd_set_base(args: argparse.Namespace) -> int:
    found = read_artifact(args.slug, "spec")
    if not found:
        raise Refusal("spec.md is missing for %s" % args.slug)
    if args.branch is None:
        base, source = default_branch()
        if not base:
            raise Refusal(ask_for_base(args.slug))
        how = " (detected from %s)" % source
    else:
        base, how = args.branch.strip(), ""
        if not base:
            raise Refusal("the base cannot be empty; name the branch this work merges into")
    write_artifact(args.slug, "spec", set_frontmatter(found[2], {"base": base, "updated": today()}))
    print("spec.md base is now %s%s" % (base, how))
    return 0


def path_from_root(path: Path, root: Path) -> str:
    """The path relative to the project root, or in full when it lies outside it."""
    return path.relative_to(root).as_posix() if root in path.parents else str(path)


def uncommitted_lines(root: Path, left_out: Path) -> list[str]:
    """`git status --porcelain` for the whole tree, one line per file, without the file at `left_out`."""
    pathspecs = ["."]
    if root in left_out.parents:
        pathspecs.append(":(exclude,literal)%s" % path_from_root(left_out, root))
    listing = git_output("status", "--porcelain", "--untracked-files=all", "--", *pathspecs, cwd=root)
    if listing is None:
        raise Refusal("git status failed in %s; run this inside the project's git repository" % root)
    return listing.splitlines()


@command(
    "uncommitted",
    "List every uncommitted path except the spec's own review.md, which a review leaves uncommitted until acceptance; a private spec folder is never listed",
    (["slug"], {"nargs": "?"}),
)
def cmd_uncommitted(args: argparse.Namespace) -> int:
    slug = resolve_slug(args.slug)
    if not (sdd_dir() / slug).is_dir():
        raise Refusal("no working folder for %s under %s" % (slug, sdd_dir()))
    root = project_root()
    review = artifact_path(slug, "review")
    lines = uncommitted_lines(root, review)
    for line in lines:
        print(line)
    count = "%d uncommitted path%s" % (len(lines), "" if len(lines) == 1 else "s")
    if spec_store().mode == SHARED:
        print("%s, not counting %s" % (count, path_from_root(review, root)))
    else:
        print("%s; git lists nothing under the private spec folder %s" % (count, sdd_dir()))
    return 0


# --- tasks parsing -----------------------------------------------------------

CHECK_ITEM = re.compile(r"^- \[( |x|X)\] (.*\S)\s*$")
TASK_TEXT = re.compile(r"^(T\d{3})\s+(.*)$")
SUB_FIELD = re.compile(r"^\s+- ([A-Za-z][A-Za-z ]*?):\s*(.*)$")
SLICE_HEADING = re.compile(r"^## (P\d+)\b")


def parse_task_items(body: str) -> list[dict]:
    """Checkbox items in tasks.md with their sub-bullet fields.

    Items under Follow-ups are not progress, so they are left out.
    """
    items: list[dict] = []
    slice_name = None
    skipping = False
    for number, line in enumerate(body.splitlines(), start=1):
        if line.startswith("## "):
            skipping = bool(FOLLOW_UPS.match(line))
            match = SLICE_HEADING.match(line)
            slice_name = match.group(1) if match else None
            continue
        if skipping:
            continue
        item = CHECK_ITEM.match(line)
        if item:
            text = item.group(2)
            task = TASK_TEXT.match(text)
            items.append(
                {
                    "line": number,
                    "checked": item.group(1) != " ",
                    "text": text,
                    "id": task.group(1) if task else None,
                    "title": task.group(2) if task else text,
                    "slice": slice_name,
                    "fields": {},
                }
            )
            continue
        field = SUB_FIELD.match(line)
        if field and items:
            items[-1]["fields"][field.group(1).strip().lower()] = field.group(2).strip()
    return items


def task_progress(body: str) -> dict:
    items = parse_task_items(body)
    tasks = [item for item in items if item["id"]]
    unchecked = [item for item in items if not item["checked"]]
    return {
        "done": sum(1 for item in tasks if item["checked"]),
        "total": len(tasks),
        "next": unchecked[0]["text"] if unchecked else None,
    }


# --- journal -----------------------------------------------------------------

# Each kind of entry and what it waits on; a `resolved` entry settles the ones before it.
JOURNAL_AWAITS = {
    "report": "the session to act on it",
    "question": "the user's answer",
    "answer": "the session to act on it",
    "decision": "the session to act on it",
    "resolved": None,
}
JOURNAL_ENTRY = re.compile(r"^## (\d+)\. (\w+) (\w+)(?: ([\w.-]+))?, (\S+)$")
JOURNAL_REF = re.compile(r"^[\w.-]+$")
JOURNAL_FENCE = re.compile(r"^(`{3,})text$")
BACKTICK_RUN = re.compile(r"`+")


def journal_path(slug: str) -> Path:
    return artifact_path(slug, "journal")


def shown_path(path: Path) -> str:
    """A path as git prints it, relative to the project root, or absolute when it sits outside."""
    try:
        return str(path.relative_to(project_root()))
    except ValueError:
        return str(path)


def phase_word(phase: str) -> str:
    """`5. Implement` as `implement`, the form a journal entry records."""
    return phase.split(" ")[-1].lower()


def read_journal(slug: str) -> list[dict]:
    """Every journal entry in the order written.

    An entry's text sits inside a fence, so a line of it can never pass for the next entry's heading.
    """
    path = journal_path(slug)
    if not path.is_file():
        return []
    entries: list[dict] = []
    lines: list[str] = []
    closing_fence = None
    for line in path.read_text().splitlines():
        if closing_fence:
            if line == closing_fence:
                entries[-1]["text"] = "\n".join(lines)
                closing_fence = None
            else:
                lines.append(line)
            continue
        heading = JOURNAL_ENTRY.match(line)
        if heading:
            number, phase, kind, ref, at = heading.groups()
            entries.append({"number": int(number), "phase": phase, "kind": kind, "ref": ref, "at": at, "text": ""})
            continue
        opening = JOURNAL_FENCE.match(line)
        if opening and entries:
            closing_fence, lines = opening.group(1), []
    return entries


def entry_label(entry: dict) -> str:
    return " ".join(part for part in (entry["phase"], entry["kind"], entry["ref"]) if part)


def journal_header(slug: str) -> str:
    title = read_artifact(slug, "spec")[0].get("title") or title_from_slug(slug)
    return (
        "# %s journal\n\n"
        "Append-only record of the agent reports, questions, answers and decisions behind this change, written by `sdd journal`.\n"
        "Never edit an entry by hand.\n" % title
    )


def journal_entry_text(entry: dict) -> str:
    """One entry as it is appended, written the way Prettier would: no trailing whitespace, and a fence longer than any backtick run in the text."""
    longest_run = max((len(run) for run in BACKTICK_RUN.findall(entry["text"])), default=0)
    fence = "`" * max(3, longest_run + 1)
    return "\n## %d. %s, %s\n\n%stext\n%s\n%s\n" % (
        entry["number"],
        entry_label(entry),
        entry["at"],
        fence,
        entry["text"],
        fence,
    )


def journal_state(slug: str, phase: str) -> dict:
    """What `sdd status` reports: the last entry is pending until a `resolved` entry or a later phase settles it."""
    entries = read_journal(slug)
    pending = None
    if entries:
        last = entries[-1]
        awaits = JOURNAL_AWAITS.get(last["kind"])
        if awaits and last["phase"] == phase_word(phase):
            pending = dict(last, awaits=awaits)
    return {"path": shown_path(journal_path(slug)), "entries": len(entries), "pending": pending}


def describe_journal(journal: dict) -> str:
    count = "%d entr%s" % (journal["entries"], "y" if journal["entries"] == 1 else "ies")
    pending = journal["pending"]
    if not pending:
        return "journal: %s, nothing pending" % count
    about = " ".join(part for part in (pending["kind"], pending["ref"]) if part)
    return "journal: %s, pending #%d %s (%s), awaiting %s" % (
        count,
        pending["number"],
        about,
        pending["at"],
        pending["awaits"],
    )


def add_journal_entry(slug: str, kind: str | None, ref: str | None, text: str | None) -> int:
    if not kind:
        raise Refusal("journal add needs a kind: %s" % ", ".join(JOURNAL_AWAITS))
    if text is None:
        text = "" if sys.stdin.isatty() else sys.stdin.read()
    text = "\n".join(line.rstrip() for line in text.splitlines()).strip("\n")
    if not text:
        raise Refusal("journal add needs the entry text, in --text or on stdin")
    entry = {
        "number": len(read_journal(slug)) + 1,
        "phase": phase_word(collect_status(slug)["phase"]),
        "kind": kind,
        "ref": ref,
        "at": now(),
        "text": text,
    }
    path = journal_path(slug)
    is_new = not path.is_file()
    with path.open("a") as journal:
        if is_new:
            journal.write(journal_header(slug))
        journal.write(journal_entry_text(entry))
    print("recorded #%d %s in %s" % (entry["number"], entry_label(entry), shown_path(path)))
    return 0


def show_journal(slug: str, kind: str | None, ref: str | None) -> int:
    entries = [
        entry
        for entry in read_journal(slug)
        if (not kind or entry["kind"] == kind) and (not ref or entry["ref"] == ref)
    ]
    if not entries:
        print("no journal entries%s" % (" match" if kind or ref else ""))
        return 0
    for entry in entries:
        print("%d. %s, %s" % (entry["number"], entry_label(entry), entry["at"]))
        print(entry["text"])
        print()
    return 0


@command(
    "journal",
    "Append an entry to a spec's journal of reports, questions, answers and decisions, or print its entries",
    (["slug"], {}),
    (["action"], {"choices": ["add", "show"]}),
    (["kind"], {"nargs": "?", "choices": list(JOURNAL_AWAITS), "help": "the kind to add, or the kind to show"}),
    (["--ref"], {"help": "what the entry is about, such as a slice (P1); with show, only entries about it"}),
    (["--text"], {"help": "the entry text for add; read from stdin when absent"}),
)
def cmd_journal(args: argparse.Namespace) -> int:
    if not artifact_path(args.slug, "spec").is_file():
        raise Refusal("no spec for %s under %s" % (args.slug, sdd_dir()))
    if args.ref and not JOURNAL_REF.match(args.ref):
        raise Refusal("--ref %r must be one word of letters, digits, dots, dashes or underscores" % args.ref)
    if args.action == "show":
        return show_journal(args.slug, args.kind, args.ref)
    return add_journal_entry(args.slug, args.kind, args.ref, args.text)


# --- status ------------------------------------------------------------------

MARKER = "[NEEDS CLARIFICATION"
APPROVED_STATUSES = {"approved", "in-progress", "done"}
SETTLED_STATUSES = APPROVED_STATUSES | {"accepted"}


def artifact_state(slug: str, name: str, upstream: dict | None) -> dict:
    """What `sdd status` reports for one artifact, following section 4's state rules."""
    found = read_artifact(slug, name)
    if not found:
        return {
            "exists": False,
            "status": None,
            "hash": None,
            "approved_hash": None,
            "based_on": None,
            "changed": False,
            "stale": False,
        }
    fields, body, text = found
    status = fields.get("status", "")
    approved_hash = fields.get("approved_hash", "")
    based_on = fields.get("based_on", "")
    current = approval_hash(name, text, based_on)
    changed = name != "review" and status in APPROVED_STATUSES and not is_current_approval(name, approved_hash, text, based_on)
    stale = False
    if upstream is not None and name in UPSTREAM:
        upstream_hash = upstream["approved_hash"] or ""
        stale = (
            upstream["changed"]
            or upstream["stale"]
            or (bool(based_on) and based_on != upstream_hash)
        )
    if name == "design" and status == "skipped":
        stale = bool(uncovered_surfaces(slug, fields))
    return {
        "exists": True,
        "status": status,
        "hash": current,
        "approved_hash": approved_hash or None,
        "based_on": based_on or None,
        "changed": changed,
        "stale": stale,
    }


def count_markers(slug: str) -> int:
    found = read_artifact(slug, "spec")
    if not found:
        return 0
    return sum(1 for line in found[2].splitlines() if MARKER in line)


def design_is_open(design: dict) -> bool:
    """A design blocks planning while requested, or approved or skipped but no longer current."""
    if not design["exists"]:
        return False
    return design["status"] not in ("approved", "skipped") or design["changed"] or design["stale"]


def derive_phase(states: dict, markers: int) -> tuple[str, str | None]:
    """The phase and skill for the current state, per the table in section 4."""
    spec, design, plan, tasks, review = (states[name] for name in ARTIFACTS)
    if not spec["exists"] or spec["status"] != "approved" or spec["changed"] or markers:
        return "1. Outline", "sdd-outline"
    if design_is_open(design):
        return "2. Design", "sdd-design"
    if not plan["exists"] or plan["status"] != "approved" or plan["changed"] or plan["stale"]:
        return "3. Plan", "sdd-plan"
    if (
        not tasks["exists"]
        or tasks["status"] not in APPROVED_STATUSES
        or tasks["changed"]
        or tasks["stale"]
    ):
        return "4. Tasks", "sdd-task"
    if tasks["status"] in ("approved", "in-progress"):
        return "5. Implement", "sdd-implement"
    if not review["exists"] or review["status"] != "accepted" or review["stale"]:
        return "6. Validate", "sdd-review"
    return "Done", None


def finished_run_note(slug: str, phase: str, review: dict) -> str | None:
    """The next step for a review that was accepted, which the phase and skill alone do not name."""
    reopen = "`sdd set-status %s review open`" % slug
    if phase == "Done":
        return (
            "the run is finished; for pull request feedback or a late fix, reopen the review with %s and run sdd-review; "
            "a change in behavior goes through sdd-outline" % reopen
        )
    if phase != "6. Validate" or not review["based_on"]:
        return None
    if review["status"] == "accepted":
        return "review.md was accepted for an earlier tasks.md; reopen it with %s and run every review again" % reopen
    if review["stale"]:
        return "review.md was reopened and the tasks changed since its acceptance; run every review again"
    return "review.md was reopened after its acceptance; triage the new feedback, fix what the user picks, and accept it again"


def chain_states(slug: str) -> dict[str, dict]:
    """Every artifact's state, each computed against its upstream so staleness propagates."""
    states: dict[str, dict] = {}
    for name in ARTIFACTS:
        upstream = states.get(upstream_of(slug, name)) if name in UPSTREAM else None
        states[name] = artifact_state(slug, name, upstream)
    return states


def collect_status(slug: str) -> dict:
    states = chain_states(slug)
    markers = count_markers(slug)
    phase, skill = derive_phase(states, markers)
    tasks = read_artifact(slug, "tasks")
    spec = read_artifact(slug, "spec")
    return {
        "slug": slug,
        "folder": str(sdd_dir() / slug),
        "mode": spec_store().mode,
        "branch": spec[0].get("branch") if spec else None,
        "base": (spec[0].get("base") or None) if spec else None,
        "current_branch": current_branch(),
        "artifacts": states,
        "clarifications": markers,
        "tasks": task_progress(tasks[1]) if tasks else None,
        "journal": journal_state(slug, phase),
        "phase": phase,
        "skill": skill,
        "note": finished_run_note(slug, phase, states["review"]),
    }


def describe_artifact(name: str, state: dict, progress: dict | None) -> str:
    if not state["exists"]:
        return "%-8s missing" % name
    parts = ["%-8s %-12s" % (name, state["status"] or "(no status)")]
    if name != "review":
        parts.append("hash %s" % state["hash"])
    if state["based_on"]:
        parts.append("based_on %s" % state["based_on"])
    if state["changed"]:
        parts.append("changed since approval")
    if state["stale"]:
        parts.append("stale")
    if state["status"] in SETTLED_STATUSES and not state["changed"] and not state["stale"]:
        parts.append("current")
    if name == "tasks" and progress:
        parts.append("%d/%d done" % (progress["done"], progress["total"]))
        if progress["next"]:
            parts.append("next: %s" % progress["next"])
    return "  ".join(parts)


def describe_base(slug: str, report: dict) -> str:
    if report["base"]:
        return report["base"]
    if not report["artifacts"]["spec"]["exists"]:
        return "?"
    return "? (not recorded; %s)" % record_detected_base(slug)


@command(
    "status",
    "Report the spec folder's path and mode, each artifact's state, task progress, the phase and the skill to run",
    (["slug"], {"nargs": "?"}),
    (["--json"], {"action": "store_true"}),
)
def cmd_status(args: argparse.Namespace) -> int:
    slug = resolve_slug(args.slug)
    report = collect_status(slug)
    if args.json:
        print(json.dumps(report, indent=2))
        return 0
    print("slug: %s" % slug)
    print("folder: %s" % report["folder"])
    print("mode: %s" % describe_mode(spec_store()))
    print("branch: %s (current: %s)" % (report["branch"] or "?", report["current_branch"] or "?"))
    print("base: %s" % describe_base(slug, report))
    for name in ARTIFACTS:
        print(describe_artifact(name, report["artifacts"][name], report["tasks"]))
    print("clarification markers: %d" % report["clarifications"])
    if report["journal"]["entries"]:
        print(describe_journal(report["journal"]))
    print("phase: %s" % report["phase"])
    print("next skill: %s" % (report["skill"] or "none"))
    if report["note"]:
        print("note: %s" % report["note"])
    return 0


# --- lint --------------------------------------------------------------------


class Lint:
    """Collected findings for one artifact. Errors fail; warnings only print."""

    def __init__(self, filename: str):
        self.filename = filename
        self.errors: list[str] = []
        self.warnings: list[str] = []

    def _where(self, line: int | None) -> str:
        return "%s:%d" % (self.filename, line) if line else self.filename

    def error(self, message: str, line: int | None = None) -> None:
        self.errors.append("ERROR %s: %s" % (self._where(line), message))

    def warn(self, message: str, line: int | None = None) -> None:
        self.warnings.append("WARN %s: %s" % (self._where(line), message))

    def report(self) -> str:
        lines = self.errors + self.warnings
        lines.append(
            "%s: %d error%s, %d warning%s"
            % (
                self.filename,
                len(self.errors),
                "" if len(self.errors) == 1 else "s",
                len(self.warnings),
                "" if len(self.warnings) == 1 else "s",
            )
        )
        return "\n".join(lines)


def body_offset(text: str, body: str) -> int:
    """Number of file lines before the body, so body line numbers map to the file."""
    return text[: len(text) - len(body)].count("\n")


def sections(body: str) -> dict[str, tuple[int, list[str]]]:
    """Level-2 sections by title: (body line of the heading, lines until the next `## `)."""
    found: dict[str, tuple[int, list[str]]] = {}
    title = None
    for number, line in enumerate(body.splitlines(), start=1):
        if line.startswith("## "):
            title = line[3:].strip()
            found[title] = (number, [])
        elif title is not None:
            found[title][1].append(line)
    return found


def find_section(found: dict, title: str):
    for name, value in found.items():
        if name.lower() == title.lower():
            return value
    return None


def split_sentences(text: str) -> list[str]:
    return [s for s in re.split(r"(?<=[.!?])\s+", text.strip()) if s]


def frontmatter_line(text: str, key: str) -> int | None:
    for number, line in enumerate(text.splitlines(), start=1):
        if line.startswith(key + ":"):
            return number
        if number > 1 and line == "---":
            return None
    return None


REQUIREMENT_LINE = re.compile(r"^(\s*)- ((?:FR|NFR|INV)-[^\s:]+):?\s*(.*)$")
REQUIREMENT_ID = re.compile(r"^(FR|NFR|INV)-\d{3}$")


def requirement_definitions(body: str) -> list[dict]:
    """Every `- FR-001:` style line: id, body line, kind, whether marked removed, and its sub-lines."""
    lines = body.splitlines()
    found: list[dict] = []
    for index, line in enumerate(lines):
        match = REQUIREMENT_LINE.match(line)
        if not match:
            continue
        indent = len(match.group(1))
        children: list[str] = []
        for later in lines[index + 1 :]:
            if later.strip() == "":
                children.append(later)
                continue
            if len(later) - len(later.lstrip()) <= indent:
                break
            children.append(later)
        found.append(
            {
                "id": match.group(2),
                "line": index + 1,
                "kind": match.group(2).split("-")[0],
                "removed": match.group(3).lower().startswith("removed"),
                "children": children,
            }
        )
    return found


def spec_requirement_ids(slug: str) -> tuple[set[str], set[str]]:
    """(all defined ids, ids still in force) from the spec, or empty sets when it is missing."""
    found = read_artifact(slug, "spec")
    if not found:
        return set(), set()
    definitions = requirement_definitions(found[1])
    defined = {d["id"] for d in definitions}
    active = {d["id"] for d in definitions if not d["removed"]}
    return defined, active


SPEC_FIELDS = ("title", "slug", "branch", "status", "owner", "created", "updated", "approved_hash", "description")
SPEC_SECTIONS = ("Summary", "Problem and context", "Goals", "Non-goals", "Requirements", "Edge cases and failure behavior")
VAGUE_WORDS = re.compile(r"\b(fast|simple|robust|scalable|intuitive|user-friendly|appropriate|reasonable)\b", re.IGNORECASE)
RESULT_OPENER = "The result is"
ID_LABEL = re.compile(r"\b[A-Z]{1,4}-?\d{1,3}\b")


def lint_description(lint: Lint, text: str, description: str) -> None:
    line = frontmatter_line(text, "description")
    sentences = split_sentences(description)
    if not 1 <= len(sentences) <= 2:
        lint.error("description must be 1 or 2 sentences, found %d" % len(sentences), line)
    if len(sentences) == 2 and not sentences[1].startswith(RESULT_OPENER):
        lint.error('description sentence 2 must begin "%s"' % RESULT_OPENER, line)
    words = len(description.split())
    if words >= 50:
        lint.error("description must be under 50 words, found %d" % words, line)
    elif words > 45:
        lint.warn("description is %d words; keep it at 45 or fewer" % words, line)


def lint_summary(lint: Lint, found: dict, offset: int) -> None:
    section = find_section(found, "Summary")
    if not section:
        return
    heading_line, lines = section
    paragraphs = [p for p in "\n".join(lines).strip().split("\n\n") if p.strip()]
    line = heading_line + offset + 1
    if len(paragraphs) != 1:
        lint.error("summary must be one paragraph, found %d" % len(paragraphs), line)
        return
    count = len(split_sentences(" ".join(paragraphs[0].split())))
    if not 5 <= count <= 7:
        lint.error("summary must be 5 to 7 sentences, found %d" % count, line)


def lint_requirements(lint: Lint, body: str, offset: int) -> None:
    seen: dict[str, int] = {}
    for definition in requirement_definitions(body):
        rid, line = definition["id"], definition["line"] + offset
        if not REQUIREMENT_ID.match(rid):
            lint.error("malformed requirement id %s (expected FR-001, NFR-001 or INV-001)" % rid, line)
            continue
        if rid in seen:
            lint.error("duplicate requirement id %s (first at line %d)" % (rid, seen[rid]), line)
            continue
        seen[rid] = line
        if definition["kind"] == "FR" and not definition["removed"]:
            if not any("acceptance:" in child.lower() for child in definition["children"]):
                lint.error("%s has no Acceptance line" % rid, line)


UI_SURFACE_LINE = re.compile(r"^- ([^\s:]*)(:?)")
UI_SURFACE_ID = re.compile(r"^UI-\d{3}$")


def ui_surface_lines(body: str) -> list[tuple[str, bool, int]]:
    """(leading word, whether a colon follows it, body line) for each top-level bullet under `## UI surfaces`."""
    section = find_section(sections(body), "UI surfaces")
    if not section:
        return []
    heading_line, lines = section
    found: list[tuple[str, bool, int]] = []
    for index, line in enumerate(lines, start=1):
        match = UI_SURFACE_LINE.match(line)
        if match:
            found.append((match.group(1), bool(match.group(2)), heading_line + index))
    return found


def spec_ui_surface_ids(slug: str) -> list[str]:
    """The well-formed UI IDs the spec lists, in order and once each."""
    found = read_artifact(slug, "spec")
    if not found:
        return []
    ids = [surface_id for surface_id, _, _ in ui_surface_lines(found[1]) if UI_SURFACE_ID.match(surface_id)]
    return list(dict.fromkeys(ids))


def uncovered_surfaces(slug: str, design_fields: dict[str, str]) -> list[str]:
    """The spec's UI IDs a skipped design's `surfaces` does not list."""
    covered = set(split_list(design_fields.get("surfaces", "")))
    return [surface_id for surface_id in spec_ui_surface_ids(slug) if surface_id not in covered]


def lint_ui_surfaces(lint: Lint, body: str, offset: int) -> None:
    seen: dict[str, int] = {}
    for surface_id, has_colon, body_line in ui_surface_lines(body):
        line = body_line + offset
        if not surface_id.startswith("UI-"):
            lint.error("bullet under UI surfaces does not start with a UI ID (expected `- UI-001: ...`)", line)
            continue
        if not UI_SURFACE_ID.match(surface_id):
            lint.error("malformed UI surface id %s (expected UI-001)" % surface_id, line)
            continue
        if not has_colon:
            lint.error("UI surface %s has no colon after its ID (expected `- %s: ...`)" % (surface_id, surface_id), line)
        if surface_id in seen:
            lint.error("duplicate UI surface id %s (first at line %d)" % (surface_id, seen[surface_id]), line)
            continue
        seen[surface_id] = line


def lint_spec(slug: str) -> Lint:
    lint = Lint("spec.md")
    found = read_artifact(slug, "spec")
    if not found:
        lint.error("spec.md is missing")
        return lint
    fields, body, text = found
    offset = body_offset(text, body)
    for key in SPEC_FIELDS:
        if key not in fields:
            lint.error('missing frontmatter field "%s"' % key)
    section_map = sections(body)
    for title in SPEC_SECTIONS:
        if not find_section(section_map, title):
            lint.error('missing section "%s"' % title)
    if not fields.get("base"):
        lint.error(
            "no base branch recorded; %s, or name another with `sdd set-base %s <branch>`"
            % (record_detected_base(slug), slug),
            frontmatter_line(text, "base"),
        )
    if fields.get("description"):
        lint_description(lint, text, fields["description"])
    lint_summary(lint, section_map, offset)
    lint_requirements(lint, body, offset)
    lint_ui_surfaces(lint, body, offset)
    lint_placeholders(lint, "spec", text)
    for number, line in enumerate(text.splitlines(), start=1):
        if MARKER in line:
            lint.error("clarification marker still open: %s" % line.strip(), number)
        if not re.search(r"\d", ID_LABEL.sub("", line)):
            for word in VAGUE_WORDS.findall(line):
                lint.warn('vague word "%s" without a number nearby' % word, number)
    return lint


def template_headings(name: str) -> list[str]:
    return [line[3:].strip() for line in template(name).splitlines() if line.startswith("## ")]


def template_fields(name: str) -> list[str]:
    return list(parse_frontmatter(template(name))[0])


PLACEHOLDER = re.compile(r"<[^<>\n]+>")


def template_placeholders(name: str) -> set[str]:
    """Every `<...>` token in a template; the same token in an artifact is unfilled."""
    return set(PLACEHOLDER.findall(template(name)))


def lint_placeholders(lint: Lint, name: str, text: str) -> None:
    tokens = template_placeholders(name)
    for number, line in enumerate(text.splitlines(), start=1):
        for token in dict.fromkeys(PLACEHOLDER.findall(line)):
            if token in tokens:
                lint.error("unfilled template placeholder %s" % token, number)


def upstream_check(lint: Lint, slug: str, name: str) -> dict | None:
    """Require the upstream artifact to exist, be approved, be unchanged and not be stale."""
    upstream_name = upstream_of(slug, name)
    state = chain_states(slug)[upstream_name]
    if not state["exists"]:
        lint.error("%s.md is missing" % upstream_name)
        return None
    if state["status"] != "approved":
        lint.error("%s.md is not approved" % upstream_name)
    elif state["changed"]:
        lint.error("%s.md changed since approval; re-approve it first" % upstream_name)
    elif state["stale"]:
        lint.error("%s.md is stale; refresh it against its upstream and re-approve it first" % upstream_name)
    return state


def lint_based_on(lint: Lint, text: str, fields: dict, upstream: dict | None, upstream_name: str) -> None:
    based_on = fields.get("based_on", "")
    if not based_on or upstream is None:
        return
    expected = upstream["approved_hash"] or ""
    if based_on != expected:
        lint.error(
            "based_on %s does not match %s.md approved_hash %s" % (based_on, upstream_name, expected or "(none)"),
            frontmatter_line(text, "based_on"),
        )


TABLE_ROW = re.compile(r"^\|(.+)\|\s*$")
SEPARATOR_CELL = re.compile(r"^:?-+:?$")


def table_rows(lines: list[str]) -> list[list[str]]:
    """Cells of each data row in a markdown table, skipping the header and separator."""
    rows: list[list[str]] = []
    for line in lines:
        match = TABLE_ROW.match(line)
        if not match:
            continue
        cells = [cell.strip() for cell in match.group(1).split("|")]
        if all(SEPARATOR_CELL.match(cell) for cell in cells if cell):
            continue
        rows.append(cells)
    return rows[1:]


def is_placeholder(value: str) -> bool:
    return not value or (value.startswith("<") and value.endswith(">"))


def lint_traceability(lint: Lint, section_map: dict, offset: int, active: set[str]) -> None:
    section = find_section(section_map, "Traceability")
    if not section:
        return
    heading_line, lines = section
    rows = table_rows(lines)
    for rid in sorted(active):
        row = next((r for r in rows if re.search(r"\b%s\b" % re.escape(rid), r[0])), None)
        if row is None:
            lint.error("%s has no row in the Traceability table" % rid, heading_line + offset)
        elif len(row) < 3 or is_placeholder(row[2]):
            lint.error("%s traceability row has no seam" % rid, heading_line + offset)


def lint_plan(slug: str) -> Lint:
    lint = Lint("plan.md")
    found = read_artifact(slug, "plan")
    if not found:
        lint.error("plan.md is missing")
        return lint
    fields, body, text = found
    offset = body_offset(text, body)
    section_map = sections(body)
    for title in template_headings("plan"):
        if not find_section(section_map, title):
            lint.error('missing section "%s"' % title)
    upstream_state = upstream_check(lint, slug, "plan")
    lint_based_on(lint, text, fields, upstream_state, upstream_of(slug, "plan"))
    _, active = spec_requirement_ids(slug)
    lint_traceability(lint, section_map, offset, active)
    lint_placeholders(lint, "plan", text)
    return lint


TASK_FIELDS = ("Requirements", "Seam", "Files", "Done when")
TEST_FILE = re.compile(
    r"(^|/)(spec|specs|test|tests|__tests__|__mocks__)/|\.test\.|\.spec\.|_spec\.rb$|_test\.\w+$|(^|/)test_[^/]*\.py$"
)


def split_list(value: str) -> list[str]:
    return [part for part in re.split(r"[,\s]+", value or "") if part]


def lint_task_fields(lint: Lint, task: dict, offset: int, defined: set[str], active: set[str]) -> None:
    line = task["line"] + offset
    for field in TASK_FIELDS:
        if field.lower() not in task["fields"]:
            lint.error("%s is missing %s" % (task["id"], field), line)
    for ref in split_list(task["fields"].get("requirements", "")):
        if ref not in defined:
            lint.error("%s references unknown requirement %s" % (task["id"], ref), line)
        elif ref not in active:
            lint.error("%s references removed requirement %s" % (task["id"], ref), line)
    files = split_list(task["fields"].get("files", ""))
    if files and all(TEST_FILE.search(path) for path in files):
        lint.warn("%s touches only test files; a task writes its test and the code together" % task["id"], line)


def lint_close_outs(lint: Lint, items: list[dict], offset: int) -> None:
    by_slice: dict[str, list[dict]] = {}
    for item in items:
        if item["slice"]:
            by_slice.setdefault(item["slice"], []).append(item)
    for slice_name, slice_items in by_slice.items():
        close_out = slice_items[-1]
        line = close_out["line"] + offset
        if close_out["id"] or "close" not in close_out["text"].lower():
            lint.error("slice %s does not end with a close-out item" % slice_name, line)
            continue
        unchecked = [item["id"] or item["text"] for item in slice_items if not item["checked"]]
        if close_out["checked"] and unchecked:
            lint.error(
                "slice %s is closed with unchecked work: %s; uncheck its close-out so sdd-implement builds it"
                % (slice_name, ", ".join(unchecked)),
                line,
            )


VERIFIED_ENTRY = re.compile(r"^- ((?:FR|NFR|INV)-[^\s:]+):\s*\S")


def verified_elsewhere(body: str) -> list[tuple[str, int]]:
    """(requirement id, body line) for each entry under `## Verified elsewhere`."""
    section = find_section(sections(body), "Verified elsewhere")
    if not section:
        return []
    heading_line, lines = section
    entries: list[tuple[str, int]] = []
    for index, line in enumerate(lines, start=1):
        match = VERIFIED_ENTRY.match(line)
        if match:
            entries.append((match.group(1), heading_line + index))
    return entries


def lint_coverage(lint: Lint, body: str, tasks: list[dict], offset: int, defined: set[str], active: set[str]) -> None:
    """Every FR needs a task; every NFR and INV needs a task or a Verified elsewhere entry."""
    verified = verified_elsewhere(body)
    for rid, line in verified:
        if rid not in defined:
            lint.error("Verified elsewhere names unknown requirement %s" % rid, line + offset)
        elif rid not in active:
            lint.error("Verified elsewhere names removed requirement %s" % rid, line + offset)
    verified_ids = {rid for rid, _ in verified}
    covered = {ref for task in tasks for ref in split_list(task["fields"].get("requirements", ""))}
    for rid in sorted(active - covered):
        if rid.startswith("FR-"):
            lint.error("%s has no task" % rid)
        elif rid not in verified_ids:
            lint.error("%s has no task and no Verified elsewhere entry" % rid)


def lint_tasks(slug: str) -> Lint:
    lint = Lint("tasks.md")
    found = read_artifact(slug, "tasks")
    if not found:
        lint.error("tasks.md is missing")
        return lint
    fields, body, text = found
    offset = body_offset(text, body)
    plan_state = upstream_check(lint, slug, "tasks")
    lint_based_on(lint, text, fields, plan_state, "plan")
    defined, active = spec_requirement_ids(slug)
    items = parse_task_items(body)
    tasks = [item for item in items if item["id"]]
    seen: dict[str, int] = {}
    for task in tasks:
        if task["id"] in seen:
            lint.error("duplicate task id %s (first at line %d)" % (task["id"], seen[task["id"]]), task["line"] + offset)
        seen.setdefault(task["id"], task["line"] + offset)
        lint_task_fields(lint, task, offset, defined, active)
    lint_coverage(lint, body, tasks, offset, defined, active)
    lint_close_outs(lint, items, offset)
    lint_placeholders(lint, "tasks", text)
    return lint


FINDING_SECTIONS = ("Spec conformance", "Correctness findings", "Standards findings")
FINDING_LINE = re.compile(r"^- (?!none\.?\s*$)", re.IGNORECASE)
DISPOSITION_LINE = re.compile(r"^\s+- Disposition:\s*([A-Za-z-]*)", re.IGNORECASE)
DISPOSITIONS = ("open", "picked", "fixed", "declined", "deferred")
PENDING_DISPOSITIONS = {
    "open": "the user has not decided it",
    "picked": "its fix is not recorded as fixed",
}


def review_findings(body: str) -> dict[int, str | None]:
    """The body line of each finding, a top-level bullet in a findings section, mapped to its disposition, or to None when no `- Disposition:` line sits under it."""
    section_map = sections(body)
    findings: dict[int, str | None] = {}
    for title in FINDING_SECTIONS:
        heading_line, lines = find_section(section_map, title) or (0, [])
        finding = None
        for index, line in enumerate(lines, start=1):
            if line.startswith("- "):
                finding = heading_line + index if FINDING_LINE.match(line) else None
                if finding:
                    findings[finding] = None
                continue
            mark = DISPOSITION_LINE.match(line)
            if mark and finding and findings[finding] is None:
                findings[finding] = mark.group(1).lower()
    return findings


def lint_dispositions(lint: Lint, body: str, offset: int) -> None:
    """Every finding carries a known disposition, and none is left for the user or a fix to settle."""
    for body_line, disposition in review_findings(body).items():
        line = body_line + offset
        if disposition is None:
            lint.error("finding has no `- Disposition:` line under it (expected one of %s)" % ", ".join(DISPOSITIONS), line)
        elif disposition not in DISPOSITIONS:
            lint.error("disposition %r is not one of %s" % (disposition, ", ".join(DISPOSITIONS)), line)
        elif disposition in PENDING_DISPOSITIONS:
            lint.error("finding is still %s; %s" % (disposition, PENDING_DISPOSITIONS[disposition]), line)


def lint_review(slug: str) -> Lint:
    lint = Lint("review.md")
    found = read_artifact(slug, "review")
    if not found:
        lint.error("review.md is missing")
        return lint
    fields, body, text = found
    for key in template_fields("review"):
        if key not in fields:
            lint.error('missing frontmatter field "%s"' % key)
    section_map = sections(body)
    for title in template_headings("review"):
        if not find_section(section_map, title):
            lint.error('missing section "%s"' % title)
    lint_dispositions(lint, body, body_offset(text, body))
    lint_placeholders(lint, "review", text)
    return lint


DESIGN_STATUSES = ("requested", "approved", "skipped")


def lint_design(slug: str) -> Lint:
    lint = Lint("design.md")
    found = read_artifact(slug, "design")
    if not found:
        lint.error("design.md is missing")
        return lint
    fields, body, text = found
    for key in template_fields("design"):
        if key not in fields:
            lint.error('missing frontmatter field "%s"' % key)
    section_map = sections(body)
    for title in template_headings("design"):
        if not find_section(section_map, title):
            lint.error('missing section "%s"' % title)
    status = fields.get("status", "")
    if status not in DESIGN_STATUSES:
        lint.error("status %r is not one of %s" % (status, ", ".join(DESIGN_STATUSES)), frontmatter_line(text, "status"))
    spec_state = upstream_check(lint, slug, "design")
    if status != "skipped":
        lint_based_on(lint, text, fields, spec_state, "spec")
    lint_placeholders(lint, "design", text)
    return lint


LINTERS = {"spec": lint_spec, "design": lint_design, "plan": lint_plan, "tasks": lint_tasks, "review": lint_review}


def run_lint(slug: str, names: list[str]) -> tuple[list[Lint], bool]:
    results = [LINTERS[name](slug) for name in names]
    return results, all(not r.errors for r in results)


@command(
    "lint",
    "Check an artifact's structure, traceability and unfilled placeholders",
    (["slug"], {}),
    (["artifact"], {"nargs": "?", "choices": sorted(LINTERS)}),
)
def cmd_lint(args: argparse.Namespace) -> int:
    if not (sdd_dir() / args.slug).is_dir():
        raise Refusal("no working folder for %s under %s" % (args.slug, sdd_dir()))
    if args.artifact:
        if not artifact_path(args.slug, args.artifact).is_file():
            raise Refusal("%s has no %s.md" % (args.slug, args.artifact))
        names = [args.artifact]
    else:
        names = [name for name in LINTERS if artifact_path(args.slug, name).is_file()]
    results, clean = run_lint(args.slug, names)
    for result in results:
        print(result.report())
    return 0 if clean else 1


# --- approval and status changes --------------------------------------------

DESIGN_RECORD_FIELDS = ("link", "version", "read")


def require_design_record(fields: dict[str, str]) -> None:
    """A design is approved only once the artifact it names has been read into the snapshot."""
    missing = [key for key in DESIGN_RECORD_FIELDS if not fields.get(key)]
    if missing:
        raise Refusal("design.md has no %s; record the design before approving it" % ", ".join(missing))


@command(
    "approve",
    "Record the user's approval of an artifact (run only after they approve in the conversation)",
    (["slug"], {}),
    (["artifact"], {"choices": ["spec", "design", "plan", "tasks"]}),
)
def cmd_approve(args: argparse.Namespace) -> int:
    slug, name = args.slug, args.artifact
    found = read_artifact(slug, name)
    if not found:
        raise Refusal("%s.md is missing for %s" % (name, slug))
    lint = LINTERS[name](slug)
    print(lint.report())
    if lint.errors:
        raise Refusal("lint reported errors; fix them before approving %s.md" % name)
    fields, body, text = found
    if name == "design":
        require_design_record(fields)
    updates = {"status": "approved", "updated": today()}
    if name in UPSTREAM:
        upstream = artifact_state(slug, upstream_of(slug, name), None)
        updates["based_on"] = upstream["approved_hash"] or ""
    updates["approved_hash"] = approval_hash(name, text, updates.get("based_on", ""))
    write_artifact(slug, name, set_frontmatter(text, updates))
    print("%s.md approved; approved_hash %s" % (name, updates["approved_hash"]))
    return 0


DESIGN_TRANSITIONS = {
    "requested": {"requested", "skipped", "approved"},
    "skipped": {"requested", "skipped"},
}


def new_design_text(slug: str) -> str:
    title = "%s design" % read_artifact(slug, "spec")[0].get("title", title_from_slug(slug))
    text = set_frontmatter(template("design"), {"title": title, "slug": slug})
    return re.sub(r"^# .*$", "# " + title, text, count=1, flags=re.MULTILINE)


REREQUEST_CLEARED_FIELDS = DESIGN_RECORD_FIELDS + ("design_system", "approved_hash", "decided_by", "surfaces")


def set_design_status(slug: str, status: str) -> int:
    """Record a design request or skip against the approved spec, creating design.md when absent."""
    if status not in DESIGN_TRANSITIONS:
        raise Refusal("design.md cannot be set to %r; allowed: %s" % (status, ", ".join(DESIGN_TRANSITIONS)))
    spec = artifact_state(slug, "spec", None)
    if spec["status"] != "approved" or spec["changed"]:
        raise Refusal("spec.md must be approved and unchanged since approval before a design is %s" % status)
    surfaces = spec_ui_surface_ids(slug)
    found = read_artifact(slug, "design")
    if not found and not surfaces:
        raise Refusal("spec.md lists no UI surface, so it takes no design")
    if found:
        current = found[0].get("status", "")
        if current not in DESIGN_TRANSITIONS[status]:
            raise Refusal(
                "design.md is %r; it must be %s before %s"
                % (current, " or ".join(sorted(DESIGN_TRANSITIONS[status])), status)
            )
    text = found[2] if found else new_design_text(slug)
    updates = {"status": status, "based_on": spec["approved_hash"], "updated": today()}
    if status == "skipped":
        updates["decided_by"] = git("config", "user.name") or ""
        updates["surfaces"] = ", ".join(surfaces)
    if status == "requested":
        updates.update(dict.fromkeys(REREQUEST_CLEARED_FIELDS, ""))
    write_artifact(slug, "design", set_frontmatter(text, updates))
    print("design.md is now %s" % status)
    return 0


TRANSITIONS = {
    ("tasks", "in-progress"): {"approved", "in-progress"},
    ("tasks", "done"): {"approved", "in-progress"},
    ("review", "accepted"): {"open"},
    ("review", "open"): {"accepted"},
}


@command(
    "set-status",
    "Record a design request or skip, move tasks.md to in-progress or done, or review.md to accepted or back to open",
    (["slug"], {}),
    (["artifact"], {"choices": ["design", "tasks", "review"]}),
    (["status"], {}),
)
def cmd_set_status(args: argparse.Namespace) -> int:
    if args.artifact == "design":
        return set_design_status(args.slug, args.status)
    key = (args.artifact, args.status)
    if key not in TRANSITIONS:
        allowed = ", ".join(status for artifact, status in TRANSITIONS if artifact == args.artifact)
        raise Refusal("%s.md cannot be set to %r; allowed: %s" % (args.artifact, args.status, allowed))
    found = read_artifact(args.slug, args.artifact)
    if not found:
        raise Refusal("%s.md is missing for %s" % (args.artifact, args.slug))
    fields, body, text = found
    current = fields.get("status", "")
    if current not in TRANSITIONS[key]:
        raise Refusal(
            "%s.md is %r; it must be %s before %s"
            % (args.artifact, current, " or ".join(sorted(TRANSITIONS[key])), args.status)
        )
    if key == ("tasks", "done"):
        unchecked = [item for item in parse_task_items(body) if not item["checked"]]
        if unchecked:
            raise Refusal(
                "%d item%s still unchecked, first: %s"
                % (len(unchecked), "" if len(unchecked) == 1 else "s", unchecked[0]["text"])
            )
    updates = {"status": args.status, "updated": today()}
    if key == ("review", "accepted"):
        lint = lint_review(args.slug)
        print(lint.report())
        if lint.errors:
            raise Refusal("lint reported errors; fix them before accepting review.md")
        updates["based_on"] = artifact_state(args.slug, "tasks", None)["approved_hash"] or ""
    write_artifact(args.slug, args.artifact, set_frontmatter(text, updates))
    print("%s.md is now %s" % (args.artifact, args.status))
    return 0


# --- templates and references -----------------------------------------------

APPENDICES = (
    ("A", "Spec template", "spec"),
    ("B", "Design record template", "design"),
    ("C", "Plan template", "plan"),
    ("D", "Tasks template", "tasks"),
    ("E", "Review report template", "review"),
)
FENCE = re.compile(r"^(`{3,})markdown\s*$")


def document_text() -> str:
    path = sdd_home() / DOC_NAME
    if not path.is_file():
        raise Refusal("the SDD document is missing at %s" % path)
    return path.read_text()


def extract_templates(doc: str) -> dict[str, str]:
    """The fenced markdown block under each appendix heading, keyed by template name."""
    lines = doc.splitlines()
    found: dict[str, str] = {}
    for letter, title, name in APPENDICES:
        heading = "## Appendix %s: %s" % (letter, title)
        try:
            start = lines.index(heading)
        except ValueError:
            raise Refusal("Appendix %s (%s) not found in the document" % (letter, title))
        block: list[str] = []
        fence = None
        for line in lines[start + 1 :]:
            if fence is None:
                match = FENCE.match(line)
                if match:
                    fence = match.group(1)
                elif line.startswith("## "):
                    break
                continue
            if line.strip() == fence:
                found[name] = "\n".join(block) + "\n"
                break
            block.append(line)
        if name not in found:
            raise Refusal("Appendix %s (%s) has no closing ````markdown block" % (letter, title))
    return found


@command(
    "templates",
    "Regenerate the templates folder from the document's appendices",
    (["action"], {"choices": ["sync"]}),
    (["--check"], {"action": "store_true", "help": "fail if the templates have drifted from the document"}),
)
def cmd_templates(args: argparse.Namespace) -> int:
    templates = extract_templates(document_text())
    folder = sdd_home() / "templates"
    if args.check:
        drifted = [
            name
            for name, text in templates.items()
            if not (folder / (name + ".md")).is_file() or (folder / (name + ".md")).read_text() != text
        ]
        if drifted:
            print("templates drifted from the document: %s" % ", ".join(n + ".md" for n in drifted))
            print("run `sdd templates sync` to regenerate them")
            return 1
        print("templates are in sync with the document")
        return 0
    folder.mkdir(parents=True, exist_ok=True)
    for name, text in templates.items():
        (folder / (name + ".md")).write_text(text)
        print("wrote %s" % (folder / (name + ".md")))
    return 0


NUMBERED_HEADING = re.compile(r"^## (\d+)\. (.*)$")
APPENDIX_HEADING = re.compile(r"^## Appendix ([A-Z]): (.*)$")
SECTION_REF = re.compile(r"\bsection (\d+) \(([^)]+)\)", re.IGNORECASE)
APPENDIX_REF = re.compile(r"\bAppendix ([A-Z]) \(([^)]+)\)")


def document_headings(doc: str) -> dict[str, str]:
    headings: dict[str, str] = {}
    for line in doc.splitlines():
        match = NUMBERED_HEADING.match(line) or APPENDIX_HEADING.match(line)
        if match:
            headings[match.group(1)] = match.group(2).replace("`", "")
    return headings


def reference_files() -> list[Path]:
    files: list[Path] = []
    for name in SKILL_NAMES:
        files.extend(sorted((skills_dir() / name).rglob("*.md")))
    readme = sdd_home() / "README.md"
    if readme.is_file():
        files.append(readme)
    return files


@command("check-refs", "Check every section reference in the skills and README against the document")
def cmd_check_refs(args: argparse.Namespace) -> int:
    headings = document_headings(document_text())
    misses: list[str] = []
    count = 0
    files = reference_files()
    for path in files:
        for number, line in enumerate(path.read_text().splitlines(), start=1):
            for pattern in (SECTION_REF, APPENDIX_REF):
                for key, title in pattern.findall(line):
                    count += 1
                    heading = headings.get(key)
                    if heading is None or title.lower() not in heading.lower():
                        label = ("section %s (%s)" if pattern is SECTION_REF else "Appendix %s (%s)") % (key, title)
                        found = "heading is %r" % heading if heading else "no such section"
                        misses.append("%s:%d: %s does not match the document; %s" % (path, number, label, found))
    for miss in misses:
        print(miss)
    print("%d references checked across %d files, %d mismatched" % (count, len(files), len(misses)))
    return 1 if misses else 0


# --- entry point -------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="sdd", description=__doc__.splitlines()[0])
    subparsers = parser.add_subparsers(dest="command", required=True)
    for name, help_text, arguments, fn in COMMANDS:
        sub = subparsers.add_parser(name, help=help_text)
        for flags, kwargs in arguments:
            sub.add_argument(*flags, **kwargs)
        sub.set_defaults(fn=fn)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    spec_store.cache_clear()
    try:
        return args.fn(args)
    except Refusal as refusal:
        print("sdd: %s" % refusal, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
