{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__playwright-local__*",
      "mcp__firefox-devtools__*",
      "mcp__chrome-devtools__*",
      "mcp__plugin_cloudflare_cloudflare-docs__search_cloudflare_documentation"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.production)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.test)",
      "Read(//**/.env.dev)",
      "Read(//**/.env.prod)",
      "Read(//**/.env.preview)",
      "Read(//**/.env.qa)",
      "Read(//**/.env.ci)",
      "Read(//**/.env.keys)",
      "Read(//**/.env.vault)",
      "Read(//**/.env.*.local)",
      "Read(//**/.*.vars)",
      "Read(//**/.*.vars.*)",
      "Read(//**/secrets/**)",
      "Read(//**/.ssh/**)",
      "Read(//**/.claude.json)",
      "Read(//**/.config/gh/**)",
      "Read(//**/.docker/config.json)",
      "Read(//**/.kube/config)",
      "Edit(//**/.env)",
      "Edit(//**/.env.local)",
      "Edit(//**/.env.development)",
      "Edit(//**/.env.production)",
      "Edit(//**/.env.staging)",
      "Edit(//**/.env.test)",
      "Edit(//**/.env.dev)",
      "Edit(//**/.env.prod)",
      "Edit(//**/.env.preview)",
      "Edit(//**/.env.qa)",
      "Edit(//**/.env.ci)",
      "Edit(//**/.env.keys)",
      "Edit(//**/.env.vault)",
      "Edit(//**/.env.*.local)",
      "Edit(//**/.*.vars)",
      "Edit(//**/.*.vars.*)",
      "Edit(//**/secrets/**)",
      "Edit(//**/.ssh/**)",
      "Edit(//**/.claude.json)",
      "Edit(//**/.config/gh/**)",
      "Edit(//**/.docker/config.json)",
      "Edit(//**/.kube/config)",
      "Bash(npx*)",
      "Bash(pnpm dlx*)",
      "Bash(clerk*)",
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler pages deploy*)",
      "Bash(*wrangler versions deploy*)",
      "Bash(*wrangler publish*)",
      "Bash(*pnpm deploy*)",
      "Bash(*run deploy*)"
    ],
    "ask": ["Bash(git*--force)", "Bash(git reset --hard*)", "Bash(*wrangler*--remote*)"],
    "defaultMode": "default"
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); case \"$input\" in *git*) printf '%s' \"$input\" | node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main.mjs\";; esac"
          },
          {
            "type": "command",
            "command": "input=$(cat); case \"$input\" in *.env*|*.vars*|*secret*|*.ssh*|*.claude.json*|*.config/gh*|*.docker*|*.kube*) printf '%s' \"$input\" | node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secret-read.mjs\";; esac"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false
  },
  "claudeMdExcludes": []
}
