# .husky/pre-commit

default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
default_branch=${default_branch#origin/}
default_branch=${default_branch:-main}
if [ "$(git branch --show-current)" = "$default_branch" ]; then
  echo "pre-commit: refusing to commit on $default_branch; create a feature branch first (git switch -c <type>/<slug>)." >&2
  exit 1
fi

# NUL-delimited so filenames with spaces, globs (*), or leading dashes are
# passed verbatim; -r skips prettier entirely on a deletion-only commit and
# -- stops prettier parsing any filename as a flag.

git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r pnpm exec prettier --write --ignore-unknown --
git update-index --again
